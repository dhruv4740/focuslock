{
  "name": "focuslock-windows-agent",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "agent:cli": "node src/agent.js",
    "check": "node --check src/agent.js",
    "install-startup": "powershell -ExecutionPolicy Bypass -File ./scripts/install-startup-task.ps1",
    "remove-startup": "powershell -ExecutionPolicy Bypass -File ./scripts/remove-startup-task.ps1",
    "profile:list": "node src/profile-cli.js list",
    "profile:set": "node src/profile-cli.js set",
    "focus:start": "node src/focus-cli.js start",
    "focus:stop": "node src/focus-cli.js stop",
    "focus:status": "node src/focus-cli.js status",
    "emergency": "node src/emergency-cli.js"
  },
  "dependencies": {
    "active-win": "^8.1.0",
    "firebase": "^12.13.0"
  },
  "devDependencies": {
    "electron": "^42.2.0"
  }
}
