<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true"
    android:padding="@dimen/space_xl">

    <TextView
        android:id="@+id/txtOnboardProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textAppearance="@style/TextAppearance.FocusLock.Caption"/>

    <TextView
        android:id="@+id/txtOnboardEyebrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:textAppearance="@style/TextAppearance.FocusLock.Eyebrow"/>

    <TextView
        android:id="@+id/txtOnboardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:textAppearance="@style/TextAppearance.FocusLock.Display"/>

    <TextView
        android:id="@+id/txtOnboardBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:lineSpacingExtra="4dp"
        android:textAppearance="@style/TextAppearance.FocusLock.Body.Secondary"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:background="@drawable/card_background"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <TextView
            android:id="@+id/txtOnboardTipTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.FocusLock.Eyebrow"/>

        <TextView
            android:id="@+id/txtOnboardTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:lineSpacingExtra="3dp"
            android:textAppearance="@style/TextAppearance.FocusLock.BodySmall.Secondary"/>

        <TextView
            android:id="@+id/txtOnboardReadiness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:textAppearance="@style/TextAppearance.FocusLock.BodySmall.Accent"/>
    </LinearLayout>

    <EditText
        android:id="@+id/editOnboardSyncId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:hint="Private sync code"
        android:inputType="textNoSuggestions"
        android:maxLines="1"
        android:padding="@dimen/card_padding"
        android:background="@drawable/edittext_background"
        android:textColorHint="@color/text_secondary"
        android:visibility="gone"
        android:textAppearance="@style/TextAppearance.FocusLock.Body"/>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <Button
        android:id="@+id/btnOnboardPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/button_primary"
        android:textColor="@color/text_primary"/>

    <Button
        android:id="@+id/btnOnboardSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:background="@drawable/button_secondary"
        android:textAppearance="@style/TextAppearance.FocusLock.Label"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnOnboardBack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Back"
            android:background="@drawable/button_secondary"
            android:textAppearance="@style/TextAppearance.FocusLock.Label"/>

        <Button
            android:id="@+id/btnOnboardNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_sm"
            android:text="Continue"
            android:background="@drawable/button_secondary"
            android:textAppearance="@style/TextAppearance.FocusLock.Label"/>
    </LinearLayout>
</LinearLayout>
