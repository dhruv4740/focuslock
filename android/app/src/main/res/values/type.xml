<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Type scale. Base sizes/weights only; color-specific leaves below apply
         the two on-surface roles actually used in the layouts. -->

    <style name="TextAppearance.FocusLock.Display" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.FocusLock.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.FocusLock.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.FocusLock.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.FocusLock.Body.Secondary">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.FocusLock.BodySmall" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.FocusLock.BodySmall.Secondary">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.FocusLock.BodySmall.Accent">
        <item name="android:textColor">@color/color_accent</item>
    </style>

    <style name="TextAppearance.FocusLock.Label" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.FocusLock.Label.Secondary">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.FocusLock.Label.Large">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.FocusLock.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.FocusLock.Caption.OnSurface">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Section-header "eyebrow" style: preserved as-is from the existing look
         (bold, color_primary, letterSpacing 0.1). Note: strings are already
         typed in caps in the layout, so textAllCaps is not set here — adding
         it would be a no-op given current copy, but is included for safety
         if copy ever changes to mixed case. -->
    <style name="TextAppearance.FocusLock.Eyebrow" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_primary</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
