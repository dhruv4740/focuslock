rules_version = '2';

// FocusLock Firestore security rules.
//
// The Android app and Windows agent both authenticate with Firebase Anonymous
// Auth before any read/write. Beyond requiring auth, access to a given sync
// code's data tree (`users/{userId}`) is restricted to uids that have joined
// that tree's `members` allowlist — established the first time a client
// signs in under that sync code (see ensureMembership() in
// windows-agent/src/firebase.js and FocusPolicyClient.kt on Android). The
// sync code itself is still the pairing secret (anyone who knows it can
// join), but a client can no longer read, enumerate, or wipe a tree it was
// never told the code for — matching the "you + one trusted person" trust
// model this app targets, not full multi-tenant isolation of unknown parties.
//
// Deploy via Firebase Console → Firestore → Rules, or
// `firebase deploy --only firestore:rules`. See docs/UPDATES.md for the
// client-rollout ordering this depends on.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Fetching one doc by id is allowed for any authenticated client (a
      // not-yet-joined client needs to read this before deciding to join);
      // `list` (querying the whole /users collection) is denied so trees
      // can't be enumerated.
      allow get: if request.auth != null;
      allow list: if false;

      // First client to use a sync code creates the doc with itself as the
      // sole member.
      allow create: if request.auth != null
        && request.resource.data.members == [request.auth.uid];

      // Joining: a client may only add itself, never remove existing
      // members or add someone else's uid on their behalf, one at a time,
      // capped to a small allowlist size.
      allow update: if request.auth != null
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() <= resource.data.members.size() + 1
        && request.resource.data.members.size() <= 5
        && request.auth.uid in request.resource.data.members;

      match /{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/users/$(userId)).data.members;
      }
    }

    // Phase 4 identity: profiles/{uid} and friendships/{pairId} are
    // independent of the users/{userId} sync-code tree above — a friend can
    // be on a completely different sync code, so lookups here are keyed by
    // Firebase uid, not by sync-tree membership.

    match /profiles/{uid} {
      // Any authenticated client can read any profile — that's how a friend
      // code lookup resolves a stranger's uid before a friendship exists.
      allow read: if request.auth != null;
      // Only the profile's own owner may create/update/delete it.
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /friendships/{pairId} {
      // Only the two named uids may read or write their own edge.
      allow read: if request.auth != null
        && request.auth.uid in resource.data.uids;

      // A pending request may only be created by one of the two uids, for
      // themselves (requestedBy must be the caller), status must start
      // pending, and pairId must actually match the sorted uid pair so a
      // client can't squat on an arbitrary document id.
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.uids.size() == 2
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && pairId == request.resource.data.uids[0] + '_' + request.resource.data.uids[1];

      // Accepting: only the uid that did NOT send the request may flip
      // pending -> accepted (no self-accept); requestedBy/uids are immutable.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.uids
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.auth.uid != resource.data.requestedBy
        && request.resource.data.requestedBy == resource.data.requestedBy
        && request.resource.data.uids == resource.data.uids;

      // Either side can delete the edge (unfriend / cancel a request).
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.uids;
    }

    // Append-only policy-change log (anti-cheat visibility signal — see the
    // reel-counting plan Part E). Owner-writable, any-authenticated-friend-
    // readable (same open-read pattern as profiles/{uid}: a friend code
    // lookup or leaderboard view needs to resolve a stranger's entries before
    // any friendship exists). No update/delete — a user cannot scrub their
    // own loosening history.
    match /policy_changes/{uid}/entries/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if false;
    }

    // Accountability-partner approval requests (opt-in alternative/addition to
    // the pure time-delay ratchet — see PolicyRatchet/ApprovalGate). Owner-
    // keyed like policy_changes above, with a "requests" subcollection (not
    // "entries") so a collectionGroup query over one name never mixes with
    // policy_changes' "entries" documents, which lack partnerUid/status.
    // Append-only: no delete, so a rejected/approved request stays as history.
    match /approval_requests/{ownerUid}/requests/{requestId} {
      allow read: if request.auth != null
        && (request.auth.uid == ownerUid || request.auth.uid == resource.data.partnerUid);

      // Only the owner can create their own request, and only in the pending
      // state — a client can't pre-seed an approved/rejected doc.
      allow create: if request.auth != null
        && request.auth.uid == ownerUid
        && request.resource.data.ownerUid == ownerUid
        && request.resource.data.status == 'pending';

      // Only the designated partner may respond, flipping pending -> approved
      // or pending -> rejected, and nothing else about the doc may change
      // (no self-approval: ownerUid != caller is implied since the partner
      // field can't equal the owner's own uid for a legitimate request, but
      // checked explicitly here too).
      allow update: if request.auth != null
        && ownerUid != request.auth.uid
        && request.auth.uid == resource.data.partnerUid
        && resource.data.status == 'pending'
        && (request.resource.data.status == 'approved' || request.resource.data.status == 'rejected')
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.partnerUid == resource.data.partnerUid
        && request.resource.data.summaries == resource.data.summaries
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    // Leaderboard entries: one doc per uid, written by that uid's own client
    // whenever recordTodaysStreakOutcome() runs. Same open-read pattern as
    // profiles/{uid} and policy_changes above.
    match /leaderboards/current/entries/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Group challenges (see FocusPolicyClient.createChallenge/getMyChallenges).
    // Design: create-once, no edits — the simplest defensible shape for this
    // slice. Any authed user may create a challenge naming themselves as
    // creator and including themselves in participantUids; only a
    // participant may read it; the doc is otherwise fully immutable (no
    // update/delete) — a creator can't rewrite dates/participants after the
    // fact, and this sidesteps needing separate rules for "who may edit
    // what field".
    match /challenges/{challengeId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participantUids;

      allow create: if request.auth != null
        && request.resource.data.creatorUid == request.auth.uid
        && request.auth.uid in request.resource.data.participantUids;

      allow update, delete: if false;

      // Progress docs: one per participant, written only by that uid's own
      // client (mirrors leaderboards/current/entries above), readable by any
      // participant of the parent challenge so a leaderboard view works.
      match /progress/{uid} {
        allow read: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/challenges/$(challengeId)).data.participantUids;

        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
