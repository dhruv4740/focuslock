rules_version = '2';

// FocusLock Firestore security rules.
//
// The Android app and Windows agent both authenticate with Firebase Anonymous
// Auth before any read/write. These rules require an authenticated request,
// which closes the database to the open internet (the API key ships inside the
// distributed app, so "open" rules would let anyone read or wipe the data).
//
// This does NOT isolate one sync code from another — any authenticated client
// could read another tree if it knew the code. That matches the current trust
// model (you + one trusted user). Publish via Firebase Console → Firestore →
// Rules, or `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
